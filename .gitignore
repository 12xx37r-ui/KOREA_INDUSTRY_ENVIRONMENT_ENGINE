# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Test / coverage cache
.pytest_cache/
.coverage
htmlcov/
.tox/

# Locally-cached upstream JSON (regenerated each run from GitHub or LKG)
input_cache/latest/*.json
input_cache/latest/*.meta.json
# Keep the .github/keep placeholder so the directory is tracked
!input_cache/latest/.github/

# Per-industry output snapshots — these are regenerated by the engine every run.
# The canonical data lives in output/industry_environment_latest.json and
# output/industry_dashboard.json which ARE committed.
output/industries/

# Other local runtime outputs (regenerated; not needed for reproducibility)
output/industry_environment_history.json
output/industry_valuation_history.json
output/validation/industry_valuation_history.json

# IDE / OS
.venv/
venv/
.env
.DS_Store
Thumbs.db
*.swp
*.swo
